# Создаётся автоматически: scripts/configure.sh (со случайным паролем). Здесь — описание переменных.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55433
# Для разработки (scripts/app.sh). В Docker приложение подключается к postgres само.
DATABASE_URL=postgres://skladno:change-me@127.0.0.1:55433/skladno
BIND=127.0.0.1:8090
# HTTP-порт приложения (по умолчанию только localhost сервера; снаружи — через HTTPS/Caddy).
# APP_BIND=127.0.0.1
# APP_PORT=8090
# Файлы документов поставок: по умолчанию том Docker «files». Путь к папке сервера — например,
# смонтированной SMB-шары (см. README): FILES_PATH=/mnt/skladno-docs
# FILES_PATH=
